meta {
  name: List Files
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/files?search=&parent_id=&page=1&per_page=15
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
  timeout: 0
