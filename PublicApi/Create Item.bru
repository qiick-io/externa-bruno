meta {
  name: Create Item
  type: http
  seq: 6
}

vars:pre-request {
  collection_slug: posts
}

post {
  url: {{base_url}}/api/v1/collections/{{collection_slug}}/items
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "data": {}
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns create success or expected client error", function () {
    expect(res.getStatus()).to.be.oneOf([201, 401, 403, 404, 422]);
  });

  test("201 body has created item shape", function () {
    if (res.getStatus() !== 201) return;
    const body = res.getBody();
    expect(body).to.have.property("data").that.is.an("object");
    expect(body.data).to.include.keys("id", "data");
  });
}

docs {
  # Create Item
  
  Creates an item. Fill `data` with field values matching the collection schema.
  
  **Method:** POST  
  **Endpoint:** `{{base_url}}/api/v1/collections/{{collection_slug}}/items`  
  **Auth:** Bearer inherit  
  **Permission:** `create`
  
  ---
  
  ## Body
  
  ```json
  {
    "data": {
      "title": "New post"
    }
  }
  ```

  Blocks field example:

  ```json
  {
    "data": {
      "content": [
        {
          "id": "11111111-1111-1111-1111-111111111111",
          "type": "rich_text",
          "data": {
            "title": { "en": "Hello", "it": "Ciao" },
            "body": { "en": "<p>Body</p>" }
          }
        }
      ]
    }
  }
  ```

  Map field (GeoJSON Point; MultiPoint uses `"type": "MultiPoint"` and an array of `[lng, lat]` pairs). Legacy `{ "lat", "lng" }` is still accepted on write:

  ```json
  {
    "data": {
      "location": {
        "type": "Point",
        "coordinates": [9.19, 45.4642]
      }
    }
  }
  ```

  Many-to-many with junction metadata (see also **Create Item With Junction Meta**):

  ```json
  {
    "data": {
      "related_tags": [
        { "related_item_id": 1, "meta": { "sort": 1 } }
      ]
    }
  }
  ```
  
  Empty `{}` works only if the collection has no required fields.
  
  ---
  
  ## Response (201)
  
  Same item shape as Get Item.
  
  ## Errors
  
  | Status | Cause |
  |--------|-------|
  | 403 | No `create` (e.g. public role with read-only) |
  | 422 | Validation / unknown keys / singleton already has item |
  | 404 | Unknown collection |
  
  ---
  
  ## Tip
  
  After a successful create, copy `data.id` into the request-local `item_id` in Update/Delete requests you want to run.
}
