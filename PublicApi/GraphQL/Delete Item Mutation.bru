meta {
  name: Delete Item Mutation
  type: http
  seq: 5
}

vars:pre-request {
  collection_slug: posts
  item_id: 1
}

post {
  url: {{base_url}}/api/graphql
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "query": "mutation ($slug: String!, $id: ID!) { deleteItem(collection: $slug, id: $id) }",
    "variables": {
      "slug": "{{collection_slug}}",
      "id": "{{item_id}}"
    }
  }
}

tests {
  test("returns HTTP 200 or auth error", function () {
    expect(res.getStatus()).to.be.oneOf([200, 401, 403]);
  });

  test("GraphQL payload has data or errors when HTTP 200", function () {
    if (res.getStatus() !== 200) return;
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.data != null || body.errors != null).to.equal(true);
  });
}

docs {
  # GraphQL deleteItem
  Requires `delete`. Soft-delete semantics match REST.
}
