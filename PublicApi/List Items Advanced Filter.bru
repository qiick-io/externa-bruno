meta {
  name: List Items Advanced Filter
  type: http
  seq: 5
}

vars:pre-request {
  collection_slug: posts
  include: files,users
}

get {
  url: {{base_url}}/api/v1/collections/{{collection_slug}}/items?filter[status][_eq]=published&page=1&per_page=15&include={{include}}
  body: none
  auth: inherit
}

params:query {
  filter[status][_eq]: published
  page: 1
  per_page: 15
  include: {{include}}
}

headers {
  Accept: application/json
}

tests {
  test("returns 200 or expected client error", function () {
    expect(res.getStatus()).to.be.oneOf([200, 401, 403, 404]);
  });

  test("200 body is paginated list", function () {
    if (res.getStatus() !== 200) return;
    const body = res.getBody();
    expect(body).to.have.property("data").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
    expect(body.meta).to.include.keys("current_page", "per_page", "total");
  });

  test("include=files: expanded file objects expose url", function () {
    if (res.getStatus() !== 200) return;
    function assertExpandedFiles(val) {
      if (val == null || typeof val !== "object") return;
      if (Array.isArray(val)) {
        val.forEach(assertExpandedFiles);
        return;
      }
      if (typeof val.filename === "string" && typeof val.id === "number") {
        expect(val).to.have.property("url").that.is.a("string").and.not.empty;
      }
      Object.keys(val).forEach(function (k) {
        assertExpandedFiles(val[k]);
      });
    }
    (res.getBody().data || []).forEach(function (row) {
      assertExpandedFiles(row.data);
    });
  });
}

docs {
  # Advanced filters

  Operators: `_eq`, `_neq`, `_contains`, `_in`, `_null`, `_nnull`, `_gt`, `_gte`, `_lt`, `_lte`.
  Plain `filter[title]=foo` still means contains.

  Same `include` CSV as **List Items** (default `files,users`). Use `files,users,<relation>` for a typical site list without N+1.
}
