meta {
  name: Create Item Mutation
  type: http
  seq: 3
}

vars:pre-request {
  collection_slug: posts
}

post {
  url: {{base_url}}/api/graphql
  body: json
  auth: inherit
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "query": "mutation ($slug: String!, $data: JSON!) { createItem(collection: $slug, data: $data) { id data } }",
    "variables": {
      "slug": "{{collection_slug}}",
      "data": {
        "title": "GraphQL create",
        "status": "draft"
      }
    }
  }
}

tests {
  test("returns HTTP 200 or auth error", function () {
    expect(res.getStatus()).to.be.oneOf([200, 401, 403]);
  });

  test("GraphQL payload has data or errors when HTTP 200", function () {
    if (res.getStatus() !== 200) return;
    const body = res.getBody();
    expect(body).to.be.an("object");
    expect(body.data != null || body.errors != null).to.equal(true);
  });

  test("createItem shape when successful", function () {
    if (res.getStatus() !== 200) return;
    const created = res.getBody().data && res.getBody().data.createItem;
    if (!created) return;
    expect(created).to.include.keys("id", "data");
  });
}

docs {
  # GraphQL createItem
  Requires `create` on the collection for the API key / public role. Same validation as REST POST.
}
