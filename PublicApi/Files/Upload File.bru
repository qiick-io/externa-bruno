meta {
  name: Upload File
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/v1/files
  body: multipartForm
  auth: inherit
}

headers {
  Accept: application/json
}

body:multipart-form {
  file: @file(fixtures/sample.png)
  parent_id: 
  name: 
}

settings {
  encodeUrl: true
  timeout: 0
}

tests {
  test("returns create success or expected client error", function () {
    // 400/422 when sample @file path is missing; still validates error vs crash
    expect(res.getStatus()).to.be.oneOf([201, 400, 401, 403, 422]);
  });

  test("201 body has file data", function () {
    if (res.getStatus() !== 201) return;
    const body = res.getBody();
    expect(body).to.have.property("data").that.is.an("object");
    expect(body.data).to.include.keys("id");
  });
}

docs {
  # Upload File
  
  **Method:** POST  
  **Endpoint:** `{{base_url}}/api/v1/files`  
  **Permission:** `file:create`
  
  Multipart field `file` (required). Optional `parent_id`, `name`.
  
  Ships with `@file(fixtures/sample.png)` (1×1 PNG) so collection runs do not ENOENT. Replace with a real asset when uploading for real.
}
