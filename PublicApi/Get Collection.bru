  name: Get Collection
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/collections/{{collection_slug}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get Collection
  
  Returns one collection by slug, including a field schema summary.
  
  **Method:** GET  
  **Endpoint:** `{{base_url}}/api/v1/collections/{{collection_slug}}`  
  **Auth:** Bearer inherit  
  **Permission:** `read` on that collection
  
  ---
  
  ## Env
  
  | Variable | Example |
  |----------|---------|
  | collection_slug | `posts` |
  
  ---
  
  ## Response (200)
  
  ```json
  {
    "data": {
      "id": 1,
      "name": "Posts",
      "slug": "posts",
      "is_singleton": false,
      "fields": [
        {
          "id": 10,
          "name": "title",
          "type": "text",
          "settings": {}
        }
      ]
    }
  }
  ```
  
  ## Errors
  
  | Status | Cause |
  |--------|-------|
  | 403 | Role lacks `read` |
  | 404 | Unknown slug |
  | 401 | Bad API key |
}
