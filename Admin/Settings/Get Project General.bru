meta {
  name: Get Project General
  type: http
  seq: 1
}

get {
  url: {{base_url}}/settings/project
  body: none
  auth: inherit
}

headers {
  Accept: text/html, application/xhtml+xml
  X-Requested-With: XMLHttpRequest
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get Project General
  
  Inertia edit page for **General** project settings (name, description, url, report_* links).
  
  **Method:** GET  
  **Endpoint:** `{{base_url}}/settings/project`  
  **Route name:** `project.edit`  
  **Permission:** `CanManageProjectSettings`  
  **Auth:** session cookie (not API Bearer)
  
  Since externa-core **1.3.0** (#201) this page is general-only; other concerns moved to `/settings/project/{section}`.
  
  Response: Inertia HTML/JSON for `settings/project` (or login redirect when unauthenticated).
}
