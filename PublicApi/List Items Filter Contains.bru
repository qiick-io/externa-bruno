meta {
  name: List Items Filter Contains
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/v1/collections/{{collection_slug}}/items?filter[title][_contains]=hello&page=1&per_page=15
  body: none
  auth: inherit
}

params:query {
  filter[title][_contains]: hello
  page: 1
  per_page: 15
}

headers {
  Accept: application/json
}

docs {
  # Advanced filter — contains
  Explicit `_contains`. Plain `filter[title]=hello` is the same (backward compatible).
}
