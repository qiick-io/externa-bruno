vars {
  base_url: http://externa-core.test
  api_key: 
  collection_slug: posts
  item_id: 1
  file_id: 1
  webhook_secret: 
}

docs {
  # Externa Local
  
  Local Herd environment for the Public CMS API.
  
  | Variable | Notes |
  |----------|-------|
  | base_url | No trailing slash |
  | api_key | Paste `ek_…` from Admin → API Keys (leave empty for anonymous-only tests) |
  | collection_slug | Must exist in externa-core |
  | item_id | Existing item for get/update/delete |
  | file_id | Existing file for get/content/transform/patch/delete |
  | webhook_secret | Project settings webhook secret (HMAC helper in Webhooks/) |
}
