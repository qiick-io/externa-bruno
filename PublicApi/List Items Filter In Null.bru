meta {
  name: List Items Filter In Null
  type: http
  seq: 7
}

vars:pre-request {
  collection_slug: posts
  include: files,users
}

get {
  url: {{base_url}}/api/v1/collections/{{collection_slug}}/items?filter[status][_in]=published,draft&filter[body][_nnull]=1&include={{include}}
  body: none
  auth: inherit
}

params:query {
  filter[status][_in]: published,draft
  filter[body][_nnull]: 1
  include: {{include}}
}

headers {
  Accept: application/json
}

tests {
  test("returns 200 or expected client error", function () {
    expect(res.getStatus()).to.be.oneOf([200, 401, 403, 404]);
  });

  test("200 body is paginated list", function () {
    if (res.getStatus() !== 200) return;
    const body = res.getBody();
    expect(body).to.have.property("data").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
    expect(body.meta).to.include.keys("current_page", "per_page", "total");
  });
}

docs {
  # Advanced filters — _in + _nnull

  Multiple filter fields are AND-combined. Operators: `_eq`, `_neq`, `_contains`, `_in`, `_null`, `_nnull`, `_gt`, `_gte`, `_lt`, `_lte`.

  Request var `include` defaults to `files` (same as **List Items**).
}
