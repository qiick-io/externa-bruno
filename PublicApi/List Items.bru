meta {
  name: List Items
  type: http
  seq: 4
}

get {
  url: {{base_url}}/api/v1/collections/{{collection_slug}}/items?page=1&per_page=15&include={{include}}
  body: none
  auth: inherit
}

params:query {
  page: 1
  per_page: 15
  include: {{include}}
  ~locale: 
  ~include_all_translations: 
}

headers {
  Accept: application/json
}

vars:pre-request {
  collection_slug: posts
  include: files,users
}

tests {
  test("returns 200 or expected client error", function () {
    expect(res.getStatus()).to.be.oneOf([200, 401, 403, 404]);
  });
  
  test("200 body is paginated list", function () {
    if (res.getStatus() !== 200) return;
    const body = res.getBody();
    expect(body).to.have.property("data").that.is.an("array");
    expect(body).to.have.property("meta").that.is.an("object");
    expect(body.meta).to.include.keys("current_page", "per_page", "total");
  });
  
  test("each item has id and data when present", function () {
    if (res.getStatus() !== 200) return;
    (res.getBody().data || []).forEach(function (row) {
      expect(row).to.include.keys("id", "data");
      expect(row.data).to.be.an("object");
    });
  });
  
  test("include=files: expanded file objects expose url", function () {
    if (res.getStatus() !== 200) return;
    function assertExpandedFiles(val) {
      if (val == null || typeof val !== "object") return;
      if (Array.isArray(val)) {
        val.forEach(assertExpandedFiles);
        return;
      }
      // ExpandedFileField shape from FileFieldExpander
      if (typeof val.filename === "string" && typeof val.id === "number") {
        expect(val).to.have.property("url").that.is.a("string").and.not.empty;
      }
      Object.keys(val).forEach(function (k) {
        assertExpandedFiles(val[k]);
      });
    }
    (res.getBody().data || []).forEach(function (row) {
      assertExpandedFiles(row.data);
    });
  });
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # List Items
  
  Paginated items for a collection.
  
  **Method:** GET  
  **Endpoint:** `{{base_url}}/api/v1/collections/{{collection_slug}}/items`  
  **Auth:** Bearer inherit  
  **Permission:** `read`
  
  ---
  
  ## Query params
  
  | Param | Default | Notes |
  |-------|---------|-------|
  | page | 1 | |
  | per_page | 15 | Clamped 1–100 |
  | include | files,users | CSV: `files`, `users`, relation field names (depth 1). Lean without it — **breaking:** clients need `include=files` for expanded media |
  | locale | — | Flattened translatable fields |
  | include_all_translations | — | `true` to include all locales |
  | filter[field] | — | Optional field filters |
  
  Request var `include` defaults to `files`. Clear or change it (e.g. `files,author,users`) as needed. Disabled params in Bruno start with `~` — enable as needed.
  
  ---
  
  ## Response (200)
  
  ```json
  {
    "data": [
      {
        "id": 1,
        "collection_id": 3,
        "data": { "title": "Hello" },
        "created_at": "2026-07-20T12:00:00+00:00",
        "updated_at": "2026-07-20T12:00:00+00:00"
      }
    ],
    "meta": {
      "current_page": 1,
      "last_page": 1,
      "per_page": 15,
      "total": 1
    }
  }
  ```
  
  ## Errors
  
  | Status | Cause |
  |--------|-------|
  | 403 | No `read` grant |
  | 404 | Unknown collection slug |
}
