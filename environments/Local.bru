vars {
  @description('No trailing slash')
  base_url: http://externa-core.test
  @description('API key (ek_...). Prefer collection .env EXTERNA_API_KEY. Or paste in Bruno, then mark Secret after it is non-empty.')
  api_key: {{process.env.EXTERNA_API_KEY}}
  @description('Webhook HMAC secret. Prefer .env EXTERNA_WEBHOOK_SECRET.')
  webhook_secret: {{process.env.EXTERNA_WEBHOOK_SECRET}}
  @description('AI collection-import HMAC token. Prefer .env EXTERNA_AI_WEBHOOK_TOKEN.')
  ai_webhook_token: {{process.env.EXTERNA_AI_WEBHOOK_TOKEN}}
}
vars:secret [
  api_key
  ai_webhook_token
]
