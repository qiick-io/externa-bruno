meta {
  name: Get File
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/files/{{file_id}}
  body: none
  auth: inherit
}

headers {
  Accept: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # Get File
  
  **Method:** GET  
  **Endpoint:** `{{base_url}}/api/v1/files/{{file_id}}`  
  **Permission:** `file:read` (+ `file:read_private` when effective access is private)
  
  Returns metadata including `access` (effective), `url` (content), and `transforms` preset map.
  
  | Case | Expected |
  | --- | --- |
  | Public file + `read` | **200** |
  | Private file + `read` only (typical `public` role) | **403** |
  | Private file + `read` + `read_private` | **200** |
}
